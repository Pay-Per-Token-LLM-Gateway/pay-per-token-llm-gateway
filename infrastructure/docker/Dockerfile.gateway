# ── Build Stage ──
FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy root workspace files (pnpm-lock.yaml is required for --frozen-lockfile)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml nx.json tsconfig.base.json ./

# Copy workspace package.json files for dependency resolution
COPY packages/types/package.json packages/types/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/logger/package.json packages/logger/
COPY packages/validation/package.json packages/validation/
COPY packages/database/package.json packages/database/
COPY packages/x402-core/package.json packages/x402-core/
COPY packages/wallet/package.json packages/wallet/
COPY packages/authentication/package.json packages/authentication/
COPY packages/analytics/package.json packages/analytics/
COPY packages/notifications/package.json packages/notifications/
COPY apps/gateway/package.json apps/gateway/

# Copy source code
COPY packages/ packages/
COPY apps/gateway/ apps/gateway/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Generate Prisma client
RUN pnpm nx run database:generate

# Build gateway
RUN pnpm exec nx build gateway

# ── Production Stage ──
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production

# Install curl for health checks
RUN apk add --no-cache curl

# Copy compiled output
COPY --from=builder /app/dist/out-tsc /app/dist

# Copy node_modules (NestJS needs them at runtime)
COPY --from=builder /app/node_modules /app/node_modules

# Copy workspace packages (may be referenced at runtime)
COPY --from=builder /app/packages /app/packages

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

CMD ["node", "dist/main.js"]
