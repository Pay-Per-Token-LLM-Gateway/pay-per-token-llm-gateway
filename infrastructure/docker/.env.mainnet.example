# ═══════════════════════════════════════════════════════════════
# x402 LLM Gateway — Mainnet Environment Variables
# ═══════════════════════════════════════════════════════════════
# ⚠  ATTENTION: These variables control PRODUCTION deployments
#    that spend REAL USDC. Handle secrets with extreme care.
# ═══════════════════════════════════════════════════════════════

# ── Stellar Mainnet ─────────────────────────
STELLAR_NETWORK=mainnet
HORIZON_URL=https://horizon.stellar.org
SOROBAN_RPC_URL=https://soroban-mainnet.stellar.org

# Circle USDC issuer on Stellar mainnet
# This is the canonical Circle-controlled issuer for bridged USDC
USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Mainnet Stellar account secret key
# ⚠  Keep this secret! Never commit it to version control.
#    Fund the account with real USDC and XLM for transaction fees.
# STELLAR_SECRET_KEY=S...

# ── Database ──────────────────────────────────
# Use a managed PostgreSQL provider (Railway, AWS RDS, etc.)
# ⚠  Never use default credentials in production
DATABASE_URL=postgresql://x402:STRONG_PASSWORD@your-db-host:5432/x402_gateway

# ── Redis ─────────────────────────────────────
# Use a managed Redis provider (Railway, Upstash, ElastiCache, etc.)
REDIS_URL=redis://:STRONG_PASSWORD@your-redis-host:6379
PAYMENT_CACHE_TTL=3600
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=10

# ── Payment ───────────────────────────────────
QUOTE_EXPIRY_SECONDS=300   # 5 minutes; shorter in production
MIN_PAYMENT_AMOUNT=10000   # 0.00001 XLM in stroops

# ── Server ────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ── LLM Upstream ─────────────────────────────
# Set per-provider API keys as environment variables
# ⚠  Use a secrets manager, NOT plain env vars, for production
# UPSTREAM_API_KEY_{PROVIDER_ID}=sk-...
LLM_REQUEST_TIMEOUT=120000
LLM_MAX_RETRIES=2

# ── Security ──────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-strong-random-secret
SESSION_DURATION=86400   # 24 hours
CORS_ORIGINS=https://your-dashboard.vercel.app

# ── Email (Optional) ──────────────────────────
EMAIL_ENABLED=false
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# EMAIL_FROM=noreply@yourdomain.com

# ── Webhooks ──────────────────────────────────
WEBHOOK_ENABLED=true
WEBHOOK_RETRY_COUNT=3
WEBHOOK_RETRY_DELAY=1000

# ── Dashboard ─────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=https://your-gateway.up.railway.app
